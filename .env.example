# ──────────────────────────────────────────────────────────────────────────────
# Jenan-Biz Node.js Server – Environment Variables Template
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── OpenAI ────────────────────────────────────────────────────────────────────
# Required: your OpenAI API key (keep this secret!)
OPENAI_API_KEY=sk-...your-key-here...

# Model to use for completions (default: gpt-4o)
OPENAI_MODEL=gpt-4o

# Maximum tokens per response (default: 4096)
OPENAI_MAX_TOKENS=4096

# Request timeout in milliseconds (default: 60000)
OPENAI_TIMEOUT_MS=60000

# ── Queue ─────────────────────────────────────────────────────────────────────
# Maximum number of jobs processed simultaneously (default: 10)
QUEUE_CONCURRENCY_LIMIT=10

# Maximum number of pending jobs in the queue (default: 1000)
QUEUE_MAX_SIZE=1000

# Maximum retry attempts for failed jobs (default: 3)
QUEUE_MAX_RETRIES=3

# Base delay in ms before first retry; doubles with each attempt (default: 1000)
QUEUE_RETRY_BASE_DELAY_MS=1000

# ── Logging ───────────────────────────────────────────────────────────────────
# Log level: error | warn | info | debug (default: info)
LOG_LEVEL=info

# Directory where log files are written (default: logs)
LOG_DIR=logs

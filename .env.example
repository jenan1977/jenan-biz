# Environment Variables Template
# Copy this file to .env and fill in the values.
# Do NOT commit .env to version control.

# ──────────────────────────────────────────────
# OpenAI (required for Node.js AI features)
# ──────────────────────────────────────────────
# Get your key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Model to use (default: gpt-4o)
OPENAI_MODEL=gpt-4o

# Request timeout in milliseconds (default: 120000 = 2 minutes)
OPENAI_TIMEOUT_MS=120000

# Max tokens per response (default: 4096)
OPENAI_MAX_TOKENS=4096

# ──────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# CORS allowed origin (* = all, or specify a domain)
CORS_ORIGIN=*

# ──────────────────────────────────────────────
# Queue
# ──────────────────────────────────────────────
# Maximum concurrent jobs processed at once
QUEUE_MAX_CONCURRENCY=1000

# Maximum retry attempts per job (default: 5)
QUEUE_MAX_ATTEMPTS=5

# Base delay in ms for exponential backoff retries (default: 1000)
QUEUE_BASE_DELAY_MS=1000

# ──────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────
APP_NAME=Jenan-Biz

# ──────────────────────────────────────────────
# Database (Python/FastAPI backend)
# ──────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/jenan_biz

# Set to True to log all SQL statements (development only)
DATABASE_ECHO=False

# SQLAlchemy connection pool settings
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Set to True for development mode
DEBUG=False

# Timezone (all timestamps stored in UTC)
TIMEZONE=UTC

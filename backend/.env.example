# Environment Variables Template
# Copy this file to .env and fill in the values.
# Do NOT commit .env to version control.

# ──────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/jenan_biz

# Set to True to log all SQL statements (development only)
DATABASE_ECHO=False

# SQLAlchemy connection pool settings
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# ──────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────
APP_NAME=Jenan-Biz

# Set to True for development mode
DEBUG=False

# Timezone (all timestamps stored in UTC)
TIMEZONE=UTC

# ──────────────────────────────────────────────
# OpenAI / AI Layer (Node.js)
# ──────────────────────────────────────────────

# Your OpenAI API key (required for the AI endpoints)
OPENAI_API_KEY=sk-...

# Model to use (default: gpt-4o)
OPENAI_MODEL=gpt-4o

# Request timeout in milliseconds (default: 60000)
OPENAI_TIMEOUT_MS=60000

# ──────────────────────────────────────────────
# Queue settings
# ──────────────────────────────────────────────

# How many AI requests run concurrently (default: 50)
QUEUE_CONCURRENCY=50

# Maximum number of requests that can wait in the queue (default: 1000)
QUEUE_MAX_SIZE=1000

# How many times to retry a failed request (default: 3)
QUEUE_RETRY_LIMIT=3

# Delay before the first retry in milliseconds (doubles each attempt)
QUEUE_RETRY_DELAY_MS=1000

# ──────────────────────────────────────────────
# Node.js server
# ──────────────────────────────────────────────

# Port for the Express server (default: 3000)
PORT=3000

# Logging level: debug | info | warn | error (default: info)
LOG_LEVEL=info
